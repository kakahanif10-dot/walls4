rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'plan', 'createdAt', 'updatedAt', 'calculatorAccountSize', 'calculatorRiskPct', 'privacyPolicyAcceptedAt', 'termsAcceptedAt', 'privacyPolicyVersion', 'termsVersion']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('plan' in data) || (data.plan in ['reader', 'premium', 'institutional'])) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64)) &&
        (!('privacyPolicyAcceptedAt' in data) || (data.privacyPolicyAcceptedAt is string && data.privacyPolicyAcceptedAt.size() <= 64)) &&
        (!('termsAcceptedAt' in data) || (data.termsAcceptedAt is string && data.termsAcceptedAt.size() <= 64)) &&
        (!('privacyPolicyVersion' in data) || (data.privacyPolicyVersion is string && data.privacyPolicyVersion.size() <= 32)) &&
        (!('termsVersion' in data) || (data.termsVersion is string && data.termsVersion.size() <= 32)) &&
        (!('calculatorAccountSize' in data) || (data.calculatorAccountSize is number && data.calculatorAccountSize > 0)) &&
        (!('calculatorRiskPct' in data) || (data.calculatorRiskPct is number && data.calculatorRiskPct > 0));
    }

    // Validation for WatchlistItem
    function isValidWatchlistItem(data) {
      return data.keys().hasAll(['symbol', 'addedAt']) &&
        data.keys().hasOnly(['symbol', 'addedAt', 'note']) &&
        data.symbol is string && data.symbol.size() > 0 && data.symbol.size() <= 30 &&
        data.addedAt is string && data.addedAt.size() <= 64 &&
        (!('note' in data) || (data.note is string && data.note.size() <= 500));
    }

    // Validation for CourseProgress
    function isValidCourseProgress(data) {
      return data.keys().hasAll(['lessonId', 'completed']) &&
        data.keys().hasOnly(['lessonId', 'completed', 'updatedAt']) &&
        data.lessonId is string && data.lessonId.size() > 0 && data.lessonId.size() <= 64 &&
        data.completed is bool &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Validation for TradeIdea
    function isValidTradeIdea(data) {
      return data.keys().hasAll(['userId', 'userName', 'symbol', 'stance', 'content', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'userName', 'userAvatar', 'symbol', 'stance', 'target', 'invalidation', 'content', 'createdAt']) &&
        data.userId is string && data.userId.size() <= 128 &&
        data.userName is string && data.userName.size() <= 100 &&
        (!('userAvatar' in data) || (data.userAvatar is string && data.userAvatar.size() <= 500)) &&
        data.symbol is string && data.symbol.size() <= 30 &&
        data.stance is string && data.stance.size() <= 30 &&
        (!('target' in data) || (data.target is string && data.target.size() <= 50)) &&
        (!('invalidation' in data) || (data.invalidation is string && data.invalidation.size() <= 50)) &&
        data.content is string && data.content.size() <= 1000 &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    // User profile document
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId) && isOwner(userId) && incoming().uid == request.auth.uid && incoming().get('plan', 'reader') == 'reader' && isValidUserProfile(incoming());
      allow update: if isValidId(userId) && isOwner(userId) && incoming().uid == existing().uid && incoming().get('plan', 'reader') == existing().get('plan', 'reader') && isValidUserProfile(incoming());
      allow delete: if false;

      // Watchlist subcollection
      match /watchlist/{symbol} {
        allow get, list: if isValidId(userId) && isOwner(userId);
        allow create, update: if isValidId(userId) && isOwner(userId) && isValidWatchlistItem(incoming());
        allow delete: if isValidId(userId) && isOwner(userId);
      }

      // Course progress subcollection
      match /progress/{lessonId} {
        allow get, list: if isValidId(userId) && isOwner(userId);
        allow create, update: if isValidId(userId) && isOwner(userId) && isValidCourseProgress(incoming());
        allow delete: if isValidId(userId) && isOwner(userId);
      }
    }

    // Public community trade ideas
    match /trade_ideas/{ideaId} {
      allow get, list: if true;
      allow create: if isValidId(ideaId) && isSignedIn() && incoming().userId == request.auth.uid && isValidTradeIdea(incoming());
      allow update: if isValidId(ideaId) && isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid && isValidTradeIdea(incoming());
      allow delete: if isValidId(ideaId) && isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
