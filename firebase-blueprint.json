{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document storing user details and personal preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "plan": { "type": "string", "enum": ["reader", "premium", "institutional"], "maxLength": 30 },
        "calculatorAccountSize": { "type": "number" },
        "calculatorRiskPct": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email"]
    },
    "WatchlistItem": {
      "title": "WatchlistItem",
      "description": "A ticker symbol saved to user personal watchlist",
      "type": "object",
      "properties": {
        "symbol": { "type": "string", "maxLength": 30 },
        "addedAt": { "type": "string", "maxLength": 64 },
        "note": { "type": "string", "maxLength": 500 }
      },
      "required": ["symbol", "addedAt"]
    },
    "TradeIdea": {
      "title": "TradeIdea",
      "description": "Community trade setup or alert posted on the live trading floor",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userAvatar": { "type": "string", "maxLength": 500 },
        "symbol": { "type": "string", "maxLength": 30 },
        "stance": { "type": "string", "maxLength": 30 },
        "target": { "type": "string", "maxLength": 50 },
        "invalidation": { "type": "string", "maxLength": 50 },
        "content": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "userName", "symbol", "stance", "content", "createdAt"]
    },
    "CourseProgress": {
      "title": "CourseProgress",
      "description": "Academy video masterclass lesson completion state",
      "type": "object",
      "properties": {
        "lessonId": { "type": "string", "maxLength": 64 },
        "completed": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["lessonId", "completed"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile with preferences and subscription tier"
    },
    "/users/{userId}/watchlist/{symbol}": {
      "schema": "WatchlistItem",
      "description": "Subcollection of saved assets for a specific user"
    },
    "/users/{userId}/progress/{lessonId}": {
      "schema": "CourseProgress",
      "description": "Academy video masterclass lesson progress"
    },
    "/trade_ideas/{ideaId}": {
      "schema": "TradeIdea",
      "description": "Public trade ideas shared across the trading floor"
    }
  }
}
